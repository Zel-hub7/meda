# ==============================================================================
# Current - Local Development Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values for local development.
# Run: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (Required)
# ------------------------------------------------------------------------------
# PostgreSQL connection string. For local development, you can use:
# - Local PostgreSQL: postgresql://postgres:password@localhost:5432/current_dev
# - Neon serverless: Get a free database at https://neon.tech
DATABASE_URL=postgresql://postgres:password@localhost:5432/current_dev

# ------------------------------------------------------------------------------
# SERVER (Optional - has defaults)
# ------------------------------------------------------------------------------
# Port for the Express server (default: 5000)
PORT=5000

# Session secret for Express sessions (generate a random string for security)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-session-secret-change-in-production

# Base URL of the application (used for email links)
# For local dev, usually http://localhost:5000
BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# AI INTEGRATION (Required for AI features)
# ------------------------------------------------------------------------------
# Anthropic Claude API key for knowledge extraction
# Get your API key at https://console.anthropic.com/
AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# Optional: Custom base URL for Anthropic API (leave empty to use default)
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=

# ------------------------------------------------------------------------------
# EMAIL SERVICE (Optional - for team invitations and notifications)
# ------------------------------------------------------------------------------
# Resend API key for sending emails
# Get your API key at https://resend.com
RESEND_API_KEY=

# Email address to send from (must be verified in Resend)
RESEND_FROM_EMAIL=Current <noreply@yourdomain.com>

# Email for demo booking notifications (optional)
DEMO_NOTIFY_EMAIL=

# ------------------------------------------------------------------------------
# ADMIN ACCESS (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list of email addresses with admin access
ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------------------------
# SLACK INTEGRATION (Optional - for Slack monitoring)
# ------------------------------------------------------------------------------
# Slack OAuth credentials (get from https://api.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Legacy: Direct Socket Mode tokens (for single-workspace setup)
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# NOTION INTEGRATION (Optional - for knowledge base sync)
# ------------------------------------------------------------------------------
# Notion OAuth credentials (get from https://developers.notion.com)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# GOOGLE INTEGRATIONS (Optional - for Drive and Meet)
# ------------------------------------------------------------------------------
# Google OAuth credentials (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/oauth/google_drive/callback

# Legacy: Direct tokens (for pre-configured Google access)
GOOGLE_REFRESH_TOKEN=
GOOGLE_MEET_TOKEN=
GOOGLE_DRIVE_TOKEN=

# ------------------------------------------------------------------------------
# ZOOM INTEGRATION (Optional - for meeting transcripts)
# ------------------------------------------------------------------------------
# Zoom OAuth credentials (get from https://marketplace.zoom.us/develop)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=

# Legacy: Direct access token (for pre-configured Zoom access)
ZOOM_ACCESS_TOKEN=

# Zoom webhook verification secret
ZOOM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# REPLIT-SPECIFIC (Only needed when running on Replit)
# ------------------------------------------------------------------------------
# These are automatically set by Replit - leave empty for local development
# REPL_ID=
# REPL_IDENTITY=
# WEB_REPL_RENEWAL=
# REPLIT_DOMAINS=
# REPLIT_CONNECTORS_HOSTNAME=
# REPLIT_DEPLOYMENT=
# ISSUER_URL=https://replit.com/oidc
